  {
    "id": 22,
    "name": "[クリッカー] クリック処理",
    "trigger": 0,
    "switchId": 1,
    "list": [
      {
        "code": 355,
        "indent": 0,
        "parameters": [
          "const part = $gameVariables.value(15);",
          "let loveGain = 1.0;",
          "let pleGain = 0.0;",
          "let shakeType = 0;",
          "if (part === 1) { loveGain = 1.5; shakeType = 2; }",
          "else if (part === 2) { loveGain = 2.0; pleGain = 5.0; shakeType = 1; }",
          "else if (part === 3) { loveGain = 5.0; pleGain = 10.0; shakeType = 2; }",
          "if ($gameParty.hasItem($dataItems[58])) loveGain *= 1.5;",
          "if ($gameParty.hasItem($dataItems[62])) loveGain *= 3.0;",
          "if ($gameParty.hasItem($dataItems[52])) pleGain *= 2.0;",
          "if ($gameParty.hasItem($dataItems[61])) pleGain *= 4.0;",
          "$gameVariables.setValue(9, $gameVariables.value(9) + loveGain);",
          "$gameVariables.setValue(11, $gameVariables.value(11) + pleGain);",
          "$gameVariables.setValue(12, $gameVariables.value(12) + 1);",
          "$gameVariables.setValue(14, shakeType);",
          "const intimacy = $gameVariables.value(9);",
          "let rank = 1;",
          "if (intimacy >= 100) rank = 3; else if (intimacy >= 40) rank = 2;",
          "$gameVariables.setValue(10, rank);",
          "let seName = 'AnyConv.com__115えっち！！';",
          "if (part === 2) seName = 'AnyConv.com__136そこ…っ';",
          "if (part === 3) seName = 'AnyConv.com__181んぁっ２';",
          "AudioManager.playSe({ name: seName, pan: 0, pitch: 100, volume: 90 });"
        ]
      },
