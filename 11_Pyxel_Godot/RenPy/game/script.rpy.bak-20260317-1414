# -----------------------------------------------------
# Ren'Py Script - Animated One Scene Prototype
# -----------------------------------------------------

define n = Character(None)

default trust = 0
default airi_talking = False
default airi_chest_jiggle = 0.0
default airi_touch_count = 0

init python:
    import math
    import renpy.store as store

    AIRI_SPECS = {
        "neutral": {
            "file": "images/airi_neutral.png",
            "eyes": (220, 170, 172, 34),
            "mouth": (294, 252, 54, 16),
            "chest": (188, 216, 264, 170),
            "blink_offset": 0.8,
            "scale": 0.92,
            "xalign": 0.5,
            "base_yoffset": 0,
            "shy": 0.0,
            "jiggle": 0.42,
        },
        "angry": {
            "file": "images/airi_angry.png",
            "eyes": (188, 166, 230, 34),
            "mouth": (276, 329, 90, 20),
            "chest": (186, 246, 268, 176),
            "blink_offset": 1.9,
            "scale": 0.72,
            "xalign": 0.52,
            "base_yoffset": 14,
            "shy": 0.06,
            "jiggle": 0.28,
        },
        "shame": {
            "file": "images/airi_neutral.png",
            "eyes": (220, 170, 172, 34),
            "mouth": (294, 252, 54, 16),
            "chest": (188, 216, 264, 170),
            "blink_offset": 2.8,
            "scale": 0.9,
            "xalign": 0.54,
            "base_yoffset": 10,
            "shy": 0.85,
            "jiggle": 0.18,
        },
    }

    def airi_callback(event, interact=True, **kwargs):
        if event in ("begin", "show"):
            store.airi_talking = True
        elif event in ("end", "slow_done"):
            store.airi_talking = False

    def airi_speaking():
        return bool(store.airi_talking or renpy.music.get_playing(channel="voice"))

    def trigger_chest_touch():
        store.airi_chest_jiggle = 0.82
        store.airi_touch_count += 1
        renpy.restart_interaction()

    def blink_strength(st, offset):
        phase = (st + offset) % 4.8
        if 4.18 <= phase < 4.28:
            return (phase - 4.18) / 0.10
        if 4.28 <= phase < 4.42:
            return 1.0 - ((phase - 4.28) / 0.14)
        if 4.52 <= phase < 4.58:
            return (phase - 4.52) / 0.06
        if 4.58 <= phase < 4.66:
            return 1.0 - ((phase - 4.58) / 0.08)
        return 0.0

    def make_eye_motion(rect, offset):
        _x, _y, width, height = rect
        cx = width / 2.0
        cy = height / 2.0

        def eye_motion(trans, st, at):
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.subpixel = True
            trans.yzoom = max(0.05, 1.0 - (blink_strength(st, offset) * 0.95))
            return 0.016

        return eye_motion

    def make_mouth_motion(rect):
        _x, _y, width, height = rect
        cx = width / 2.0
        cy = height / 2.0

        def mouth_motion(trans, st, at):
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.subpixel = True

            if airi_speaking():
                phase = 0.35 + (abs(math.sin(st * 16.0)) * 0.65)
                trans.yzoom = 1.0 + (phase * 0.24)
                trans.xzoom = 1.0 - (phase * 0.04)
                trans.yoffset = int(phase * 1.5)
            else:
                trans.yzoom = 1.0
                trans.xzoom = 1.0
                trans.yoffset = 0

            return 0.016

        return mouth_motion

    def make_chest_motion(rect):
        _x, _y, width, height = rect
        cx = width / 2.0
        cy = height / 2.0

        def chest_motion(trans, st, at):
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.subpixel = True

            timer = float(store.airi_chest_jiggle)
            if timer > 0.0:
                progress = 0.82 - timer
                wobble = math.sin(progress * 28.0) * (timer / 0.82)
                pulse = abs(math.cos(progress * 18.0)) * (timer / 0.82)
                trans.alpha = 1.0
                trans.xzoom = 1.0 + (pulse * 0.045)
                trans.yzoom = 1.0 - (pulse * 0.028)
                trans.xoffset = int(wobble * 6.0)
                trans.yoffset = int(abs(wobble) * 2.0)
                store.airi_chest_jiggle = max(0.0, timer - 0.016)
            else:
                trans.alpha = 0.0
                trans.xzoom = 1.0
                trans.yzoom = 1.0
                trans.xoffset = 0
                trans.yoffset = 0

            return 0.016

        return chest_motion

    def make_body_motion(spec):
        base_scale = spec.get("scale", 1.0)
        xalign = spec.get("xalign", 0.5)
        base_yoffset = spec.get("base_yoffset", 0)
        shy = spec.get("shy", 0.0)
        jiggle_strength = spec.get("jiggle", 0.5)

        def body_motion(trans, st, at):
            talking = airi_speaking()
            breathe = math.sin(st * 1.45)
            jiggle = abs(math.sin(st * 18.0)) if talking else 0.0
            shy_sway = math.sin(st * 1.8) * shy

            trans.xalign = xalign
            trans.yalign = 1.0
            trans.anchor = (0.5, 1.0)
            trans.subpixel = True
            trans.zoom = base_scale + (breathe * 0.0018) + (jiggle * 0.003 * jiggle_strength)
            trans.xzoom = 1.0 - (jiggle * 0.002 * jiggle_strength)
            trans.yzoom = 1.0 + (jiggle * 0.006 * jiggle_strength)
            trans.xoffset = int(shy_sway * 5.0)
            trans.yoffset = int(-42 + base_yoffset + (breathe * 1.8) - (jiggle * 1.8 * jiggle_strength))
            trans.rotate = shy_sway * -0.9
            return 0.016

        return body_motion

    def build_airi_sprite(pose_name):
        spec = AIRI_SPECS[pose_name]
        eye_rect = spec["eyes"]
        mouth_rect = spec["mouth"]
        chest_rect = spec["chest"]

        return Transform(
            LiveComposite(
                (640, 640),
                (0, 0), spec["file"],
                (eye_rect[0], eye_rect[1]), Transform(spec["file"], crop=eye_rect, function=make_eye_motion(eye_rect, spec["blink_offset"])),
                (mouth_rect[0], mouth_rect[1]), Transform(spec["file"], crop=mouth_rect, function=make_mouth_motion(mouth_rect)),
                (chest_rect[0], chest_rect[1]), Transform(spec["file"], crop=chest_rect, function=make_chest_motion(chest_rect)),
            ),
            function=make_body_motion(spec),
        )

    a = Character("広瀬 愛理", color="#f0a35f", callback=airi_callback)

screen chest_touch_demo():
    modal True
    zorder 100

    frame:
        xalign 0.5
        ypos 28
        padding (18, 12)
        background Solid("#09111acc")

        vbox:
            spacing 4
            text "胸元に触れると揺れます。" size 24 color "#f4d0b8"
            text "右下の『続ける』で先へ進みます。" size 18 color "#e8eef5"

    button:
        xpos 548
        ypos 286
        xsize 188
        ysize 146
        background None
        hover_background Solid("#ffffff10")
        action [Function(trigger_chest_touch), Return("chest")]

    textbutton "続ける":
        action Return("continue")
        xpos 1094
        ypos 628

label chest_touch_loop:
    while True:
        call screen chest_touch_demo
        $ result = _return

        if result == "continue":
            $ airi_chest_jiggle = 0.0
            return

        if airi_touch_count == 1:
            voice "audio/voice/chest_s0.ogg"
            a "ひゃっ……。"
        elif airi_touch_count == 2:
            voice "audio/voice/chest_s0b.ogg"
            a "ちょ、ちょっと……急に触らないでください。"
        elif airi_touch_count == 3:
            voice "audio/voice/chest_s1.ogg"
            a "んっ……動きの確認でも、近すぎます。"
        elif airi_touch_count == 4:
            voice "audio/voice/chest_s1b.ogg"
            a "も、もう十分見えたはずです……。"
        else:
            $ airi_touch_count = 4
            voice "audio/voice/reject_01.ogg"
            a "だ、だめです。確認はここまでにしてください。"

label start:
    $ trust = 0
    $ airi_talking = False
    $ airi_chest_jiggle = 0.0
    $ airi_touch_count = 0

    scene expression Solid("#101723")
    with fade

    centered "{size=+16}放課後プロトタイプ{/size}\n{size=-8}瞬き・口パク・胸タッチつき一場面デモ{/size}"

    scene expression Solid("#29496f")
    with dissolve

    show expression build_airi_sprite("neutral") as airi
    with dissolve

    n "夕暮れの準備室。"
    voice "audio/voice/airi_scene_01.ogg"
    a "……来てくれたんですね。"
    voice "audio/voice/airi_scene_02.ogg"
    a "今日中に、一場面だけでも遊べる形にしたくて。"
    n "愛理は胸元で指を組み、こちらをまっすぐ見返した。"
    voice "audio/voice/airi_scene_03.ogg"
    a "短くても、立ち絵と会話と選択肢が揃えば、ちゃんと作品になります。"
    a "……その、動きの確認ならできます。ほどほどにしてくださいね。"

    call chest_touch_loop

    menu:
        "どう進める？"

        "演出を先に固める":
            $ trust += 1
            show expression build_airi_sprite("shame") as airi
            with dissolve
            voice "audio/voice/airi_scene_04.ogg"
            a "演出から入るの、好きです。切り替わる瞬間だけで、空気まで変わりますから。"

        "構造を先に固める":
            show expression build_airi_sprite("angry") as airi
            with dissolve
            voice "audio/voice/airi_scene_05.ogg"
            a "先に骨組みを作るんですね。堅いですけど、そのほうが後で崩れません。"

    scene expression Solid("#55315a")
    with fade

    show expression build_airi_sprite("neutral") as airi
    with dissolve

    n "窓の外で、最後の光が青から紫へ変わっていく。"
    voice "audio/voice/airi_scene_06.ogg"
    a "じゃあ最後に確認です。今夜のゴール、どっちにしますか？"

    menu:
        "今夜のゴールを決める"

        "一往復だけでも最後まで遊べるようにする":
            $ trust += 1
            jump ending_playable

        "素材をあとから差し替えやすい形まで整える":
            jump ending_editable

label ending_playable:
    scene expression Solid("#12292d")
    with fade

    show expression build_airi_sprite("shame") as airi
    with dissolve

    voice "audio/voice/airi_scene_07.ogg"
    a "それが一番強いです。短くても、触れれば企画の芯が見えます。"

    if trust >= 2:
        show expression build_airi_sprite("neutral") as airi
        with dissolve
        voice "audio/voice/airi_scene_02.ogg"
        a "次は背景と音も足して、本当に一本にしましょう。"
    else:
        show expression build_airi_sprite("angry") as airi
        with dissolve
        voice "audio/voice/airi_scene_05.ogg"
        a "でも次は、見た目ももう少し攻めてくださいね。そこ、期待してますから。"

    n "一つの場面だけでも、物語は始められる。"
    return

label ending_editable:
    scene expression Solid("#12292d")
    with fade

    show expression build_airi_sprite("neutral") as airi
    with dissolve

    voice "audio/voice/airi_scene_04.ogg"
    a "堅実でいいと思います。台詞と絵を差し替えやすくしておけば、次が一気に速くなります。"

    if trust >= 1:
        show expression build_airi_sprite("shame") as airi
        with dissolve
        voice "audio/voice/airi_scene_07.ogg"
        a "……その上で、次はちゃんと演出も盛ってください。約束です。"
    else:
        show expression build_airi_sprite("angry") as airi
        with dissolve
        voice "audio/voice/airi_scene_05.ogg"
        a "合理的すぎます。でも、その判断は嫌いじゃないです。"

    n "設計が残れば、次の場面はもっと軽く作れる。"
    return
