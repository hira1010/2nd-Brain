    def airi_callback(event, interact=True, **kwargs):
        if event in ("begin", "show"):
            renpy.store.airi_talking = True
        elif event in ("end", "slow_done"):
            renpy.store.airi_talking = False

    def airi_speaking():
        return bool(renpy.store.airi_talking or renpy.music.get_playing(channel="voice"))

    def trigger_chest_touch():
        renpy.store.airi_chest_jiggle = 1.52
        renpy.store.airi_touch_count += 1
        renpy.store.airi_blush = min(1.0, 0.24 + (renpy.store.airi_touch_count * 0.17))
        renpy.store.airi_stress = min(1.0, 0.16 + (renpy.store.airi_touch_count * 0.14))
        renpy.store.airi_sweat = min(1.0, 0.10 + (renpy.store.airi_touch_count * 0.12))
        renpy.store.airi_tremble = min(1.0, 0.08 + (renpy.store.airi_touch_count * 0.11))
        renpy.store.airi_breath_boost = min(1.0, 0.16 + (renpy.store.airi_touch_count * 0.13))
        renpy.sound.play("audio/sfx/touch_soft.wav", channel="sound")
        renpy.restart_interaction()

    def blink_strength(st, offset):
        phase = ((st * 1.18) + offset) % 3.9
        if 2.52 <= phase < 2.60:
            return (phase - 2.52) / 0.08
        if 2.60 <= phase < 2.72:
            return 1.0 - ((phase - 2.60) / 0.12)
        if 2.90 <= phase < 2.95:
            return (phase - 2.90) / 0.05
        if 2.95 <= phase < 3.03:
            return 1.0 - ((phase - 2.95) / 0.08)
        return 0.0

    def mouth_strength(st):
        beat = abs(math.sin(st * 12.8))
        accent = abs(math.sin(st * 5.4))
        return min(1.0, (beat * 0.84) + (accent * 0.42))

    def breath_strength(st, offset):
        return (math.sin((st * 1.12) + offset) + 1.0) * 0.5

    def exhale_strength(st, offset):
        pulse = max(0.0, math.sin((st * 1.12) + offset - 0.35))
        return pulse ** 2.6

    def touch_response(timer):
        if timer <= 0.0:
            return 0.0, 0.0, 0.0

        progress = 1.32 - timer
        envelope = timer * timer
        wobble = math.sin(progress * 24.0) * envelope
        pulse = abs(math.cos(progress * 18.5)) * envelope
        impact = max(0.0, min(1.0, (timer - 0.82) / 0.42))
        impact = impact * impact
        return wobble, pulse, impact

    def make_eye_motion(rect, offset):
        _, _, width, height = rect
        cx = width / 2.0
        cy = height / 2.0

        def eye_motion(trans, st, at):
            blink = blink_strength(st, offset)
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.yzoom = max(0.01, 1.0 - (blink * 0.992))
            trans.xzoom = 1.0 + (blink * 0.105)
            trans.yoffset = int(blink * 2.6)
            return 0.016

        return eye_motion

    def make_mouth_motion(rect, spec):
        _, _, width, height = rect
        cx = width / 2.0
        cy = height / 2.0
        open_scale = spec.get("mouth_open", 0.22)
        shift_scale = spec.get("mouth_shift", 1.0)
        idle_scale = spec.get("idle_mouth", 0.08)
        offset = spec.get("blink_offset", 0.0)

        def mouth_motion(trans, st, at):
            voice_amount = mouth_strength(st) if airi_speaking() else 0.0
            breath_wave = breath_strength(st, offset)
            exhale = 0.0 if airi_speaking() else exhale_strength(st, offset)
            idle_amount = ((0.45 + (breath_wave * 0.75)) * idle_scale) if not airi_speaking() else (breath_wave * 0.05)
            open_amount = voice_amount + idle_amount
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.yzoom = 1.0 + (open_amount * (open_scale * 1.36)) + (exhale * 0.08)
            trans.xzoom = 1.0 - (open_amount * min(0.16, open_scale * 0.58)) - (exhale * 0.04)
            trans.yoffset = int((open_amount * shift_scale * 2.4) + (exhale * 2.8))
            trans.alpha = 0.93 + (open_amount * 0.08) + (exhale * 0.03)
            return 0.016

        return mouth_motion

    def make_blush_motion(rect, tilt=0.0):
        _, _, width, height = rect
        cx = width / 2.0
        cy = height / 2.0

        def blush_motion(trans, st, at):
            blush = float(renpy.store.airi_blush)
            stress = float(renpy.store.airi_stress)
            pulse = abs(math.sin((st * 3.1) + (tilt * 0.03))) * blush
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.alpha = min(0.52, (blush * 0.30) + (pulse * 0.14) + (stress * 0.08))
            trans.xzoom = 1.0 + (pulse * 0.10) + (stress * 0.03)
            trans.yzoom = 1.0 + (pulse * 0.06) + (stress * 0.02)
            trans.rotate = tilt
            return 0.016

        return blush_motion

    def make_stress_line_motion(rect):
        _, _, width, height = rect
        cx = width / 2.0
        cy = height / 2.0

        def stress_line_motion(trans, st, at):
            stress = float(renpy.store.airi_stress)
            tremble = float(renpy.store.airi_tremble)
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.alpha = min(0.72, max(0.0, (stress - 0.18) * 0.92))
            trans.xzoom = 1.0 + (stress * 0.04)
            trans.yzoom = 1.0 + (stress * 0.16)
            trans.xoffset = int(math.sin((st * 18.0) + width) * tremble * 1.2)
            trans.yoffset = int(stress * 1.8)
            return 0.016

        return stress_line_motion

    def make_sweat_motion(width, height, phase=0.0):
        cx = width / 2.0
        cy = height / 2.0

        def sweat_motion(trans, st, at):
            sweat = float(renpy.store.airi_sweat)
            tremble = float(renpy.store.airi_tremble)
            drip = (math.sin((st * 2.6) + phase) + 1.0) * 0.5
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (0.5, 0.5)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.alpha = min(0.76, (sweat * 0.46) + (drip * 0.18))
            trans.xzoom = 1.0 + (drip * 0.10)
            trans.yzoom = 1.0 + (drip * 0.22)
            trans.xoffset = int(math.sin((st * 14.0) + phase) * tremble * 0.9)
            trans.yoffset = int((drip * 2.4) + (sweat * 1.8))
            return 0.016

        return sweat_motion

    def make_chest_motion(rect, spec):
        _, _, width, height = rect
        anchor_x, anchor_y = spec.get("chest_anchor", (0.5, 0.40))
        cx = width * anchor_x
        cy = height * anchor_y
        touch_bounce = spec.get("touch_bounce", 1.0)
        phase = spec.get("blink_offset", 0.0)

        def chest_motion(trans, st, at):
            _, pulse, impact = touch_response(float(renpy.store.airi_chest_jiggle))
            breath = breath_strength(st, phase) - 0.5
            trans.xpos = cx
            trans.ypos = cy
            trans.anchor = (anchor_x, anchor_y)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.xzoom = 1.0 + (breath * 0.0015) + (pulse * 0.020 * touch_bounce) + (impact * 0.032)
            trans.yzoom = 1.0 + (breath * 0.0012) + (pulse * 0.012 * touch_bounce) + (impact * 0.020)
            trans.xoffset = 0
            trans.yoffset = int(-(pulse * 1.4 * touch_bounce) - (impact * 2.2))
            trans.rotate = 0.0
            trans.alpha = 0.998
            return 0.016

        return chest_motion

    def make_breath_puff_motion(spec, delay=0.0):
        offset = spec.get("blink_offset", 0.0)

        def breath_puff_motion(trans, st, at):
            breath_boost = float(renpy.store.airi_breath_boost)
            local_time = st + delay
            exhale = 0.0 if airi_speaking() else exhale_strength(local_time, offset)
            exhale = max(exhale, breath_boost * 0.22)
            exhale *= 0.78 + (breath_boost * 0.60)
            trans.anchor = (0.0, 0.5)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.alpha = min(0.52, exhale * 0.42)
            trans.xzoom = 0.82 + (exhale * 1.14)
            trans.yzoom = 0.72 + (exhale * 1.42)
            trans.xoffset = int(exhale * (20 + (delay * 8)))
            trans.yoffset = int(-5 - (exhale * (18 + (delay * 4))))
            return 0.016

        return breath_puff_motion

    def make_sprite_motion(spec):
        base_scale = spec["scale"]
        xalign = spec["xalign"]
        base_yoffset = spec["base_yoffset"]
        phase = spec["blink_offset"]
        sway_strength = spec.get("sway", 1.0)
        front_sway = spec.get("front_sway", 0.0025)

        def sprite_motion(trans, st, at):
            talk = mouth_strength(st) if airi_speaking() else 0.0
            breath_wave = breath_strength(st, phase)
            exhale = exhale_strength(st, phase)
            blush = float(renpy.store.airi_blush)
            stress = float(renpy.store.airi_stress)
            tremble = float(renpy.store.airi_tremble)
            breath_boost = float(renpy.store.airi_breath_boost)
            sway = math.sin(st * 1.22 + phase) * sway_strength
            front = breath_wave - 0.5
            jitter = math.sin((st * 26.0) + phase) * tremble
            shake = math.cos((st * 19.0) + phase) * tremble

            if renpy.store.airi_chest_jiggle > 0.0:
                renpy.store.airi_chest_jiggle = max(0.0, renpy.store.airi_chest_jiggle - 0.009)
            if renpy.store.airi_stress > 0.0:
                renpy.store.airi_stress = max(0.0, renpy.store.airi_stress - 0.004)
            if renpy.store.airi_sweat > 0.0:
                renpy.store.airi_sweat = max(0.0, renpy.store.airi_sweat - 0.003)
            if renpy.store.airi_tremble > 0.0:
                renpy.store.airi_tremble = max(0.0, renpy.store.airi_tremble - 0.0045)
            if renpy.store.airi_breath_boost > 0.0:
                renpy.store.airi_breath_boost = max(0.0, renpy.store.airi_breath_boost - 0.004)

            trans.xalign = xalign
            trans.yalign = 1.0
            trans.anchor = (0.5, 1.0)
            trans.transform_anchor = True
            trans.subpixel = True
            trans.zoom = base_scale + (front * front_sway) + (math.sin(st * 1.38 + phase) * 0.0018) + (breath_boost * 0.0016)
            trans.xzoom = 1.0 + (front * 0.0048)
            trans.yzoom = 1.0 - (front * 0.0106)
            trans.xoffset = int((sway * 1.8) - (blush * 0.7) + (jitter * 1.2))
            trans.yoffset = int(-42 + base_yoffset - (front * 6.1) - (exhale * 2.8) - (talk * 0.65) - (breath_boost * 2.2) + (math.cos(st * 1.08 + phase) * 1.0) + (shake * 0.8))
            trans.rotate = (front * -0.22) + (sway * 0.12) + (jitter * 0.09) + (stress * 0.02)
            return 0.016

        return sprite_motion

    def build_airi_sprite(pose_name):
        spec = AIRI_SPECS[pose_name]
        eye_rect = spec["eyes"]
        mouth_rect = spec["mouth"]
        blush_left = spec["blush_left"]
        blush_right = spec["blush_right"]
        chest_rect = spec["chest"]
        chest_file = spec.get("chest_file")
        breath_pos = (mouth_rect[0] + mouth_rect[2] + 8, mouth_rect[1] - 6)
        stress_rect = (max(0, eye_rect[0] - 10), max(0, eye_rect[1] - 14), eye_rect[2] + 20, 18)
        sweat_a_pos = (max(0, eye_rect[0] - 18), eye_rect[1] - 4)
        sweat_b_pos = (mouth_rect[0] + mouth_rect[2] + 18, mouth_rect[1] - 32)
        stress_display = LiveComposite(
            (stress_rect[2], stress_rect[3]),
            (0, 2), Solid("#2b1722", xysize=(stress_rect[2], 2)),
            (8, 8), Solid("#3b2230", xysize=(stress_rect[2] - 16, 2)),
            (20, 14), Solid("#23121a", xysize=(max(18, stress_rect[2] - 40), 1)),
        )
        sweat_display = LiveComposite(
            (12, 24),
            (4, 0), Solid("#eff8ff", xysize=(4, 14)),
            (2, 10), Solid("#d9efff", xysize=(8, 10)),
        )

        return Transform(
            LiveComposite(
                (640, 640),
                (0, 0), spec["file"],
                (chest_rect[0], chest_rect[1]), Transform(chest_file, function=make_chest_motion(chest_rect, spec)),
                (blush_left[0], blush_left[1]), Transform(Solid("#ff6f93", xysize=(blush_left[2], blush_left[3])), function=make_blush_motion(blush_left, -6.0)),
                (blush_right[0], blush_right[1]), Transform(Solid("#ff6f93", xysize=(blush_right[2], blush_right[3])), function=make_blush_motion(blush_right, 6.0)),
                (eye_rect[0], eye_rect[1]), Transform(Crop(eye_rect, spec["file"]), function=make_eye_motion(eye_rect, spec["blink_offset"])),
                (mouth_rect[0], mouth_rect[1]), Transform(Crop(mouth_rect, spec["file"]), function=make_mouth_motion(mouth_rect, spec)),
                (sweat_a_pos[0], sweat_a_pos[1]), Transform(sweat_display, function=make_sweat_motion(12, 24, spec["blink_offset"])),
                (sweat_b_pos[0], sweat_b_pos[1]), Transform(sweat_display, function=make_sweat_motion(12, 24, spec["blink_offset"] + 0.9)),
                (breath_pos[0], breath_pos[1]), Transform(Text("~", size=30, color="#f4fbff"), function=make_breath_puff_motion(spec, 0.0)),
                (breath_pos[0] + 10, breath_pos[1] + 5), Transform(Text("~", size=22, color="#e8f8ff"), function=make_breath_puff_motion(spec, 0.55)),
            ),
            function=make_sprite_motion(spec),
        )
    a = Character("広瀬 愛理", color="#f0a35f", callback=airi_callback)

