            show expression build_airi_sprite("angry") as airi
            with Dissolve(0.08)
            play sound "audio/sfx/cloth_shift.wav"
            with vpunch
            voice "audio/voice/chest_s2b.ogg"
            a "ち、近いです……息まで乱れるので、少し離れてください。"
        else:
            $ airi_blush = 0.92
            $ airi_stress = 0.80
            $ airi_sweat = 0.70
            $ airi_tremble = 0.60
            $ airi_breath_boost = 0.74
            if airi_touch_count % 2 == 0:
                show expression build_airi_sprite("angry") as airi
                with Dissolve(0.08)
                play sound "audio/sfx/cloth_shift.wav"
                with vpunch
                voice "audio/voice/reject_01.ogg"
                a "だ、だめですって……そんなに何回も触らないでください。表情まで崩れます。"
            else:
                show expression build_airi_sprite("shame") as airi
                with Dissolve(0.08)
                with hpunch
                voice "audio/voice/chest_s1.ogg"
                a "んっ……もう、反応を見たいのはわかりましたから……。"

label start:
    $ trust = 0
    $ airi_talking = False
    $ airi_chest_jiggle = 0.0
    $ airi_touch_count = 0
    $ airi_blush = 0.0
    $ airi_stress = 0.0
    $ airi_sweat = 0.0
    $ airi_tremble = 0.0
    $ airi_breath_boost = 0.0
    scene expression Solid("#101723")
    with fade

    centered "{size=+16}放課後プロトタイプ{/size}\n{size=-8}瞬き・口パク・胸タッチつき一場面デモ{/size}"

    scene expression Solid("#29496f")
    with dissolve

    show expression build_airi_sprite("neutral") as airi
    with dissolve

    n "夕暮れの準備室。"
    voice "audio/voice/airi_scene_01.ogg"
    a "……来てくれたんですね。"
    voice "audio/voice/airi_scene_02.ogg"
    a "今日中に、一場面だけでも遊べる形にしたくて。"
    n "愛理は胸元で指を組み、こちらをまっすぐ見返した。"
    voice "audio/voice/airi_scene_03.ogg"
    a "短くても、立ち絵と会話と選択肢が揃えば、ちゃんと作品になります。"
    voice "audio/voice/head_01.ogg"
    a "……その、動きの確認ならできます。ほどほどにしてくださいね。"

    $ quick_menu = False
    window hide
    call chest_touch_loop
    window show
    $ quick_menu = True

    menu:
        "どう進める？"

        "演出を先に固める":
            $ trust += 1
            $ airi_blush = 0.36
            show expression build_airi_sprite("shame") as airi
            with dissolve
            voice "audio/voice/airi_scene_04.ogg"
            a "演出から入るの、好きです。切り替わる瞬間だけで、空気まで変わりますから。"

        "構造を先に固める":
            $ airi_blush = 0.08
            show expression build_airi_sprite("angry") as airi
            with dissolve
            voice "audio/voice/airi_scene_05.ogg"
            a "先に骨組みを作るんですね。堅いですけど、そのほうが後で崩れません。"

    scene expression Solid("#55315a")
    with fade

    $ airi_blush = 0.10
    show expression build_airi_sprite("neutral") as airi
    with dissolve

    n "窓の外で、最後の光が青から紫へ変わっていく。"
    voice "audio/voice/airi_scene_06.ogg"
    a "じゃあ最後に確認です。今夜のゴール、どっちにしますか？"

    menu:
        "今夜のゴールを決める"

        "一往復だけでも最後まで遊べるようにする":
            $ trust += 1
            jump ending_playable

        "素材をあとから差し替えやすい形まで整える":
            jump ending_editable

label ending_playable:
    scene expression Solid("#12292d")
    with fade

    $ airi_blush = 0.38
    show expression build_airi_sprite("shame") as airi
    with dissolve

    voice "audio/voice/airi_scene_07.ogg"
    a "それが一番強いです。短くても、触れれば企画の芯が見えます。"

    if trust >= 2:
        $ airi_blush = 0.14
        show expression build_airi_sprite("neutral") as airi
        with dissolve
        voice "audio/voice/body_01.ogg"
        a "次は背景と音も足して、本当に一本にしましょう。"
    else:
        $ airi_blush = 0.06
        show expression build_airi_sprite("angry") as airi
        with dissolve
        voice "audio/voice/head_02.ogg"
        a "でも次は、見た目ももう少し攻めてくださいね。そこ、期待してますから。"

    $ airi_blush = 0.60
    show expression build_airi_sprite("bunny") as airi
    with dissolve
    voice "audio/voice/max_stage.ogg"
    a "……最後だけ、バニーにしました。締めはこれくらい振り切った方が、覚えてもらえますから。"
    n "一つの場面だけでも、物語は始められる。"
    return

label ending_editable:
    scene expression Solid("#12292d")
    with fade

    $ airi_blush = 0.12
    show expression build_airi_sprite("neutral") as airi
    with dissolve

    voice "audio/voice/body_02.ogg"
    a "堅実でいいと思います。台詞と絵を差し替えやすくしておけば、次が一気に速くなります。"

    if trust >= 1:
        $ airi_blush = 0.42
        show expression build_airi_sprite("shame") as airi
        with dissolve
        voice "audio/voice/max_stage.ogg"
        a "……その上で、次はちゃんと演出も盛ってください。約束です。"
    else:
        $ airi_blush = 0.04
        show expression build_airi_sprite("angry") as airi
        with dissolve
        voice "audio/voice/chest_s2.ogg"
        a "合理的すぎます。でも、その判断は嫌いじゃないです。"

    $ airi_blush = 0.60
    show expression build_airi_sprite("bunny") as airi
    with dissolve
    voice "audio/voice/chest_s2b.ogg"
    a "……最後だけ、バニーにしました。締めはこれくらい振り切った方が、覚えてもらえますから。"
    n "設計が残れば、次の場面はもっと軽く作れる。"
    return























